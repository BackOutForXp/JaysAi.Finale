<!-- heavenly v3.0 -->
<Window x:Class="JaysAi.Finale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JaysAi.Finale"
        Title="JaysAi.Finale" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1A1A1A"
        Icon="Resources/appicon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#FF444444"
        BorderThickness="1"
        >

    <Border Background="#FF1A1A1A" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="10">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="JaysAi.Finale – Loader Interface"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

            <!-- Main Panel Area -->
            <Grid Grid.Row="1" Name="MainContentGrid">
                <!-- Content dynamically filled by MainControlBridge -->
                <TextBlock Text="Initializing loader..." 
                           Foreground="#FFAAAAAA" 
                           FontSize="16" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Footer / Status -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <TextBlock Text="Status: " Foreground="White" FontWeight="Bold"/>
                <TextBlock Name="StatusLabel" Text="Idle" Foreground="Lime"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
