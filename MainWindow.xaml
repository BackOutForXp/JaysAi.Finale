<!-- File: MainWindow.xaml -->
<Window x:Class="JaysAi.Finale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JaysAi.Finale - Monarch Loader"
        Height="400" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="20">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="JaysAi.Finale Loader" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="Red" 
                       TextAlignment="Center" 
                       Margin="0 0 0 20"/>

            <CheckBox x:Name="EspCheckbox"         Content="Enable ESP"         FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="AimAssistCheckbox"   Content="Enable Aim Assist"  FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="StickAssistCheckbox" Content="Enable Stick Assist" FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="StealthCheckbox"     Content="Enable Stealth Mode" FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="BoneEspCheckbox"     Content="Enable Bone ESP"    FontSize="16" Margin="0 5"/>

            <Button Content="Launch Overlay" Height="40" Margin="0 20 0 0"/>
        </StackPanel>
    </Grid>
</Window>
