<!-- Neural v3.0 — DebugConsoleOverlay.xaml -->
<UserControl x:Class="JaysAi.Finale.Overlay.DebugConsoleOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False"
             Opacity="0.95">

    <Grid>
        <Border Background="Black" CornerRadius="5" Padding="5" BorderBrush="Lime" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DebugText"
                           Foreground="Lime"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
