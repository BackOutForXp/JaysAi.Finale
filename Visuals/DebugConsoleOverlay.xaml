<UserControl x:Class="JaysAi.Finale.Visuals.DebugConsoleOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <Border Background="#99000000" CornerRadius="6" Padding="8" Margin="10">
        <TextBlock x:Name="LogText"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="Lime"
                   TextWrapping="Wrap"
                   Width="600"
                   Height="300"
                   VerticalAlignment="Top"
                   Text="Debug Console Ready..." />
    </Border>
</UserControl>
