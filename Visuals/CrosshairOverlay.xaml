<!-- Neural v3.0 — CrosshairOverlay.xaml -->
<UserControl x:Class="JaysAi.Finale.Overlay.CrosshairOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False" Height="119" Width="94">

    <Grid>
        <!-- Horizontal Line -->
        <Rectangle Fill="Red" Height="2" Width="40"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Vertical Line -->
        <Rectangle Fill="Red" Width="2" Height="40"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
