<!-- neural v3.0 -->
<Window x:Class="JaysAi.Finale.UI.Windows.LicensePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Activation"
        Height="280"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1F1F1F"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="#2A2A2A" BorderBrush="#FF2D89EF" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Enter your license key to activate JaysAi"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <TextBox x:Name="LicenseInput"
                     Grid.Row="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Padding="10"
                     Background="#303030"
                     Foreground="#DDDDDD"
                     BorderThickness="0"
                     BorderBrush="Transparent"
                     Height="35"
                     Width="320"
                     HorizontalAlignment="Center"
                     MaxLength="64"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Spacing="20">
                <Button x:Name="ActivateButton"
                        Content="Activate"
                        Width="120"
                        Height="36"
                        Background="#FF2D89EF"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="Transparent"
                        Cursor="Hand"/>

                <Button x:Name="CloseButton"
                        Content="Cancel"
                        Width="120"
                        Height="36"
                        Background="#FF3B3B3B"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="Transparent"
                        Cursor="Hand"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Text=""
                       FontSize="12"
                       Foreground="#FFC56F6F"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
