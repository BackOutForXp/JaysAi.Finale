<Window x:Class="JaysAi.Finale.Loader.LicensePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Verification"
        Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Enter your License Key" FontSize="16" Margin="0 0 0 10" HorizontalAlignment="Center"/>

            <TextBox x:Name="KeyBox" FontSize="14" Margin="0 0 0 10" Height="30"/>

            <Button Content="Validate" Click="Validate_Click" Padding="10" FontSize="14" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
