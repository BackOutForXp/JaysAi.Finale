<!-- monarch v2.1 – Loader main interface layout -->
<Window x:Class="JaysAi.Finale.Loader.LoaderGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JaysAi.Finale Loader" Height="400" Width="500"
        WindowStyle="None" ResizeMode="NoResize" Background="#1A1A1A"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">

            <Label Content="JaysAi Loader" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
            <Label Content="Status Panel" FontSize="16" Foreground="LightGray" HorizontalAlignment="Center" />

            <Button Content="Toggle ESP" Click="ToggleEsp_Click" />
            <Label x:Name="EspStatusLabel" Content="ESP: OFF" Foreground="White" />

            <Button Content="Toggle Aim Assist" Click="ToggleAimAssist_Click" />
            <Label x:Name="AimStatusLabel" Content="AIM: OFF" Foreground="White" />

            <Button Content="Toggle Snap Assist" Click="ToggleSnap_Click" />
            <Label x:Name="SnapStatusLabel" Content="SNAP: OFF" Foreground="White" />

            <Button Content="Toggle Overlay" Click="ToggleOverlay_Click" />
            <Label x:Name="OverlayStatusLabel" Content="VISUALS: OFF" Foreground="White" />

            <Button Content="Exit" Click="ExitButton_Click" Background="Red" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
