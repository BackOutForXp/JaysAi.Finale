<!-- Monarch v1.0 – AIOverlay.xaml -->
<!-- ✅ Monarch Fix Checklist
[x] Uses SkiaSharp.Views.WPF.SKElement
[x] Fullscreen transparent overlay
[x] Event-bound to PaintSurface in code-behind
-->

<Window x:Class="JaysAi.Finale.Overlay.AIOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="AIOverlay" Height="1080" Width="1920"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">

    <Grid>
        <skia:SKElement x:Name="skiaView" PaintSurface="skiaView_PaintSurface"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
    </Grid>
</Window>
