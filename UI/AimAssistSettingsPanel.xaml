<!-- Neural v3.0 -->
<UserControl x:Class="JaysAi.Finale.UI.AimAssistSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500"
             Background="#1A1A1A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Aim Assist Settings"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0 0 0 10"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
            <CheckBox x:Name="EnableAimAssistCheckBox" Content="Enable Aim Assist" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Strength:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="FOV Radius:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="FovSlider" Minimum="10" Maximum="180" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Smoothing:" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="10" Width="200"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

