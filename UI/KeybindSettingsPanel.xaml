<UserControl x:Class="JaysAi.Finale.UI.KeybindSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             Height="300" Width="600">

    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Keybind Settings" FontSize="18" FontWeight="Bold" Foreground="White" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="ESP Toggle Key:" Foreground="White" VerticalAlignment="Center" />
            <ComboBox x:Name="EspKeyDropdown" Width="120" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Aim Assist Hold Key:" Foreground="White" VerticalAlignment="Center" />
            <ComboBox x:Name="AimKeyDropdown" Width="120" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Panic Key:" Foreground="White" VerticalAlignment="Center" />
            <ComboBox x:Name="PanicKeyDropdown" Width="120" />
        </StackPanel>

        <CheckBox x:Name="AllowKeybindsCheckbox" Content="Enable All Keybinds" Foreground="White" />
    </StackPanel>
</UserControl>