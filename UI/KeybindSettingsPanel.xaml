<!-- neural v3.0 -->
<UserControl x:Class="JaysAi.Finale.Overlay.Panels.KeybindSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <StackPanel Margin="10">
        <TextBlock Text="Keybinds" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Aim Key:" Width="100"/>
            <TextBox x:Name="AimKeyBind" Width="100" LostFocus="AimKeyBind_LostFocus"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="ESP Key:" Width="100"/>
            <TextBox x:Name="ESPKeyBind" Width="100" LostFocus="ESPKeyBind_LostFocus"/>
        </StackPanel>
    </StackPanel>
</UserControl>
