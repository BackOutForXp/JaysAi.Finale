<!-- Neural v3.1 — InputDialog.xaml -->
<Window x:Class="JaysAi.Finale.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="150" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Margin="5,0,0,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" Margin="5,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
