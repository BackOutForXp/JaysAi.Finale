<!-- neural v3.0 -->
<UserControl x:Class="JaysAi.Finale.UI.Settings.StickAssistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="600"
             Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Stick Assist Settings" FontSize="18" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top" Spacing="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Deadzone Threshold:" Width="150" Foreground="White"/>
                <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Width="200" ValueChanged="DeadzoneSlider_ValueChanged"/>
                <TextBlock x:Name="DeadzoneValue" Width="50" Foreground="White"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="PID - Proportional:" Width="150" Foreground="White"/>
                <TextBox x:Name="ProportionalInput" Width="60" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="PID - Integral:" Width="150" Foreground="White"/>
                <TextBox x:Name="IntegralInput" Width="60" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="PID - Derivative:" Width="150" Foreground="White"/>
                <TextBox x:Name="DerivativeInput" Width="60" />
            </StackPanel>

            <Button Content="Apply Settings" Width="120" HorizontalAlignment="Left" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
