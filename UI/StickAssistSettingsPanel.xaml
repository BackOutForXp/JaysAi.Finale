<!-- File: UI/StickAssistSettingsPanel.xaml -->
<UserControl x:Class="JaysAi.Finale.UI.StickAssistSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto" Background="#1E1E1E">
    <StackPanel Margin="10" Spacing="8">

        <TextBlock Text="Stick Assist Settings" FontSize="18" FontWeight="Bold" Foreground="Red" Margin="0 0 0 10"/>

        <CheckBox Content="Enable Stick Assist"
                  IsChecked="{Binding Path=StickAssist.Enabled, Mode=TwoWay}"
                  FontSize="14" Foreground="White"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Snap Strength:" Width="100" VerticalAlignment="Center" Foreground="White"/>
            <Slider Minimum="0.0" Maximum="2.0" Width="150"
                    Value="{Binding Path=StickAssist.SnapStrength, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Path=StickAssist.SnapStrength, StringFormat=F2}" Margin="10 0 0 0" Foreground="White"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Deadzone Threshold:" Width="100" VerticalAlignment="Center" Foreground="White"/>
            <Slider Minimum="0.0" Maximum="1.0" Width="150"
                    Value="{Binding Path=StickAssist.DeadZoneThreshold, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Path=StickAssist.DeadZoneThreshold, StringFormat=F2}" Margin="10 0 0 0" Foreground="White"/>
        </StackPanel>

    </StackPanel>
</UserControl>
