<!-- Neural v3.1 — StickAssistSettingsPanel.xaml -->
<UserControl x:Class="JaysAi.Finale.UI.StickAssistSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical" Spacing="8">
            <TextBlock Text="🎮 Stick Assist Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>

            <CheckBox x:Name="StickAssistEnabled"
                      Content="Enable Stick Assist"
                      IsChecked="{Binding Path=All[StickAssistEnabled], Mode=TwoWay}"
                      Checked="StickAssistEnabled_Checked"
                      Unchecked="StickAssistEnabled_Unchecked"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Strength:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="StrengthSlider"
                        Minimum="0" Maximum="1"
                        Value="{Binding Path=All[StickAssistStrength], Mode=TwoWay}"
                        ValueChanged="StrengthSlider_ValueChanged"
                        Width="150"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="FOV Radius:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="RadiusSlider"
                        Minimum="0" Maximum="500"
                        Value="{Binding Path=All[StickAssistFovRadius], Mode=TwoWay}"
                        ValueChanged="RadiusSlider_ValueChanged"
                        Width="150"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
