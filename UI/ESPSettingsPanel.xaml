<!-- File: UI/ESPSettingsPanel.xaml -->
<UserControl x:Class="JaysAi.Finale.UI.ESPSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto" Background="#1E1E1E">
    <StackPanel Margin="10" Spacing="8">

        <TextBlock Text="ESP Settings" FontSize="18" FontWeight="Bold" Foreground="Red" Margin="0 0 0 10"/>

        <CheckBox Content="Enable ESP"
                  IsChecked="{Binding Path=ESP.Enabled, Mode=TwoWay}"
                  FontSize="14" Foreground="White"/>

        <CheckBox Content="Show Boxes"
                  IsChecked="{Binding Path=ESP.ShowBoxes, Mode=TwoWay}"
                  FontSize="14" Foreground="White"/>

        <CheckBox Content="Show Names"
                  IsChecked="{Binding Path=ESP.ShowNames, Mode=TwoWay}"
                  FontSize="14" Foreground="White"/>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Enemy Color:" Width="100" VerticalAlignment="Center" Foreground="White"/>
            <Button Content="Pick Color" Width="100" Click="OnPickColorClicked"/>
        </StackPanel>

    </StackPanel>
</UserControl>
