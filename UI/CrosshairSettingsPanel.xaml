<UserControl x:Class="JaysAi.Finale.UI.CrosshairSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E"
             Height="300" Width="600">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Crosshair Settings" FontSize="18" FontWeight="Bold" Foreground="White"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Size:" Foreground="White" VerticalAlignment="Center"/>
            <Slider x:Name="CrosshairSizeSlider" Minimum="5" Maximum="50" Width="200" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Thickness:" Foreground="White" VerticalAlignment="Center"/>
            <Slider x:Name="CrosshairThicknessSlider" Minimum="1" Maximum="10" Width="200" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Color:" Foreground="White" VerticalAlignment="Center"/>
            <ComboBox x:Name="CrosshairColorDropdown" Width="150">
                <ComboBoxItem Content="Red" />
                <ComboBoxItem Content="Green" />
                <ComboBoxItem Content="Blue" />
                <ComboBoxItem Content="White" />
                <ComboBoxItem Content="Yellow" />
                <ComboBoxItem Content="Cyan" />
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="CrosshairDotCheckbox" Content="Enable Center Dot" Foreground="White"/>
        <CheckBox x:Name="CrosshairCircleCheckbox" Content="Enable Outer Circle" Foreground="White"/>
    </StackPanel>
</UserControl>
