<!-- File: UI/ProfileManagerPanel.xaml -->
<UserControl x:Class="JaysAi.Finale.UI.ProfileManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock Text="Profile Manager" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

            <ComboBox x:Name="ProfileDropdown" Width="250" Height="30" 
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedProfile}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Load" Width="80" Click="LoadProfile_Click" />
                <Button Content="Save" Width="80" Click="SaveProfile_Click" />
                <Button Content="Delete" Width="80" Click="DeleteProfile_Click" />
            </StackPanel>

            <TextBox x:Name="NewProfileNameBox" Width="250" Height="25" 
                     Margin="0 10 0 0" PlaceholderText="Enter new profile name..." />

            <Button Content="Save As New" Width="250" Click="SaveAsNewProfile_Click" />
        </StackPanel>
    </Grid>
</UserControl>
