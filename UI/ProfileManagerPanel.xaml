<UserControl x:Class="JaysAi.Finale.UI.ProfileManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="300" Width="600"
             Background="#1E1E1E">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Manage Profiles" FontSize="18" FontWeight="Bold" Foreground="White"/>

        <ComboBox x:Name="ProfileDropdown" Height="30" FontSize="14"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="LoadButton" Content="Load" Width="80" />
            <Button x:Name="SaveButton" Content="Save" Width="80" />
            <Button x:Name="DeleteButton" Content="Delete" Width="80" />
        </StackPanel>

        <TextBox x:Name="NewProfileNameBox" Height="28" FontSize="14" PlaceholderText="New Profile Name..." />
        <Button x:Name="SaveAsNewButton" Content="Save As New" Width="120" Height="28"/>
    </StackPanel>
</UserControl>
