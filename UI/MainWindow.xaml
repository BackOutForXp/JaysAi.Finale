<!-- Neural v3.0 — MainWindow.xaml -->
<Window x:Class="JaysAi.Finale.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JaysAi Neural Loader" Height="480" Width="800"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0E0E0E" Foreground="White">

    <Grid Margin="20">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="300" VerticalAlignment="Top" Spacing="10">

            <TextBlock Text="Neural Overlay Controls" FontSize="22" FontWeight="Bold" Margin="0 0 0 10" />

            <CheckBox x:Name="EspToggle" Content="Enable ESP" FontSize="16"/>
            <CheckBox x:Name="CrosshairToggle" Content="Enable Crosshair" FontSize="16"/>
            <CheckBox x:Name="FovToggle" Content="Enable FOV Ring" FontSize="16"/>
            <CheckBox x:Name="DebugConsoleToggle" Content="Show Debug Console" FontSize="16"/>

            <Separator Margin="0 10 0 10"/>

            <Button x:Name="StartButton" Content="Launch Overlay" FontSize="16" Height="40"/>
            <Button x:Name="ShutdownButton" Content="Shutdown" FontSize="16" Height="40" Margin="0 5 0 0"/>

        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Text="Status: Ready"
                   FontSize="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0 0 10 10"
                   Foreground="Lime"/>
    </Grid>
</Window>
