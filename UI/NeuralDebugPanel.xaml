<UserControl x:Class="JaysAi.Finale.UI.NeuralDebugPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JaysAi.Finale.UI"
             Width="300" Height="250"
             Background="#222222" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Neural Debug Panel" FontSize="16" FontWeight="Bold" Foreground="Lime" />

        <ListView Grid.Row="1" Name="TargetList" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding EnemyId}" />
                    <GridViewColumn Header="Bone" Width="60" DisplayMemberBinding="{Binding PreferredBone}" />
                    <GridViewColumn Header="Conf" Width="60" DisplayMemberBinding="{Binding ConfidenceScore}" />
                    <GridViewColumn Header="Pred" Width="50" DisplayMemberBinding="{Binding EnablePrediction}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
