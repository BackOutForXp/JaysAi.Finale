<Window x:Class="JaysAi.Finale.UI.LoaderGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JaysAi.Finale.UI"
        Title="JaysAi.Finale - Monarch Loader"
        Height="500" Width="700"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Width="320" Spacing="15">

            <TextBlock Text="JaysAi.Finale Loader" FontSize="28" FontWeight="Bold" Foreground="Red" TextAlignment="Center" Margin="0 0 0 10"/>

            <CheckBox x:Name="EspCheckbox" Content="Enable ESP" FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="AimAssistCheckbox" Content="Enable Aim Assist" FontSize="16" Margin="0 5"/>
            <CheckBox x:Name="StickAssistCheckbox" Content="Enable Stick Assist" FontSize="16" Margin="0 5"/>

            <TabControl Margin="0 20 0 0" Height="300" Width="660" HorizontalAlignment="Center">
                <TabItem Header="Crosshair">
                    <local:CrosshairSettingsPanel />
                </TabItem>
                <TabItem Header="Aim Assist">
                    <local:AimAssistSettingsPanel />
                </TabItem>
                <TabItem Header="Keybinds">
                    <local:KeybindSettingsPanel />
                </TabItem>
                <TabItem Header="Profiles">
                    <local:ProfileManagerPanel />
                </TabItem>
            </TabControl>

        </StackPanel>
    </Grid>
</Window>
