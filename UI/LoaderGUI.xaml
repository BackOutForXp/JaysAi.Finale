<!-- neural v3.0 -->
<Window x:Class="JaysAi.Finale.UI.Loader.LoaderGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JaysAi Loader" Height="450" Width="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1a1a1a">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="JaysAi Neural Loader" 
                       FontSize="22" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button x:Name="btnLaunch" Content="Launch Loader" Width="200" Height="40"
                    Click="BtnLaunch_Click" Margin="0,10" Background="#ff3333" Foreground="White"/>

            <TextBlock x:Name="lblStatus" Text="Awaiting input..." Foreground="Gray"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
