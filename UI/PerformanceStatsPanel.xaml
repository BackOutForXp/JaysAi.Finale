<!-- Neural v3.0 — PerformanceStatsPanel.xaml -->
<UserControl x:Class="JaysAi.Finale.UI.PerformanceStatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JaysAi.Finale.UI"
             Height="Auto" Width="Auto">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Performance Stats" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding DebugState.StatusMessage}" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="FPS:"/>
            <ProgressBar Value="{Binding DebugState.CurrentFPS}" Minimum="0" Maximum="240" Height="20"/>
            <TextBlock Text="Frame Buffer Size:"/>
            <TextBlock Text="{Binding DebugState.FrameBufferSize}" />
            <TextBlock Text="Render Status:"/>
            <TextBlock Text="{Binding DebugState.IsRendering}" />
        </StackPanel>
    </Grid>
</UserControl>
